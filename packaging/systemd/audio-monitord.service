[Unit]
Description=Output audio device monitor backend (PulseAudio sinks over HTTP/SSE)
Documentation=https://github.com/maximofn/output_audio_device
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/audio-monitord
Restart=on-failure
RestartSec=2s
MemoryMax=64M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
